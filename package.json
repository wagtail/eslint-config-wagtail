{
  "name": "@wagtail/oxlint-config",
  "version": "0.1.0",
  "description": "Shareable oxlint config for Wagtail",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "plugin/"
  ],
  "author": "wagtail",
  "license": "MIT",
  "homepage": "https://github.com/wagtail/oxlint-config-wagtail#readme",
  "bugs": {
    "url": "https://github.com/wagtail/oxlint-config-wagtail/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wagtail/oxlint-config-wagtail.git"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm"
    }
  },
  "keywords": [
    "config",
    "oxlint-config",
    "oxlint",
    "oxc",
    "lint",
    "styleguide",
    "wagtail"
  ],
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.6.2",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^9.39.0",
    "eslint-import-resolver-typescript": "^4.4.0",
    "eslint-plugin-import-x": "^4.17.0",
    "eslint-plugin-react": "^7.37.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.0"
  },
  "scripts": {
    "format": "prettier --write '**/*.{js,mjs,ts,md,css,scss,yaml,yml,json,jsonc}'",
    "lint:format": "prettier --check '**/*.{js,mjs,ts,md,css,scss,yaml,yml,json,jsonc}'",
    "lint:js": "oxlint --max-warnings 0",
    "lint:readme": "node write-rules.mjs --check",
    "lint": "npm run lint:format && npm run lint:js && npm run lint:readme",
    "preflight": "npm run format && npm run lint && npm run test",
    "print-config": "oxlint --print-config",
    "test": "node --test",
    "write-rules": "node write-rules.mjs"
  },
  "prettier": {
    "singleQuote": true,
    "quoteProps": "consistent"
  }
}
